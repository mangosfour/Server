#ifndef REVISION_DATA_H
#define REVISION_DATA_H
    #define REVISION_HASH               "@rev_hash@"
    #define REVISION_DATE               "@rev_date@"
    #define REVISION_BRANCH             "@rev_branch@"

    #define DEP_ELUNA_REVISION_HASH     "@dep_eluna_rev_hash@"
    #define DEP_ELUNA_REVISION_DATE     "@dep_eluna_rev_date@"
    #define DEP_ELUNA_REVISION_BRANCH   "@dep_eluna_rev_branch@"
    #define DEP_ELUNA_REVISION_STR      "@dep_eluna_rev_hash@ @dep_eluna_rev_date@ (@dep_eluna_rev_branch@ branch)"

    #define DEP_SD3_REVISION_HASH       "@dep_sd3_rev_hash@"
    #define DEP_SD3_REVISION_DATE       "@dep_sd3_rev_date@"
    #define DEP_SD3_REVISION_BRANCH     "@dep_sd3_rev_branch@"
    #define DEP_SD3_REVISION_STR        "@dep_sd3_rev_hash@ @dep_sd3_rev_date@ (@dep_sd3_rev_branch@ branch)"

    #define CMAKE_VERSION               R"(@CMAKE_VERSION@)"
    #define CMAKE_HOST_SYSTEM           R"(@CMAKE_HOST_SYSTEM_NAME@ @CMAKE_HOST_SYSTEM_VERSION@)"

    #define PROJECT_REVISION_NR         "2201001"

    #define REALMD_DB_VERSION_NR        "22"
    #define REALMD_DB_STRUCTURE_NR      "1"
    #define REALMD_DB_CONTENT_NR        "1"
    #define REALMD_DB_UPDATE_DESCRIPT   "Release 22"

    // Structure 2: `instance_reset`.`difficulty` changed key space, from raw client
    // DifficultyIDs to the core's internal 0-based Difficulty. The two OVERLAP -- a stale
    // raid 10-normal row (raw 3) is a legal internal 3, raid 25-heroic -- so the rows cannot
    // all be told apart by inspection, and a wrong reset time then suppresses the scheduler's
    // rebuild. The core detects and discards a table the old build wrote in full, but not one
    // whose detectable rows were already cleaned, so this has to be enforced rather than
    // sniffed. STRUCTURE and not CONTENT deliberately: a version or structure mismatch is
    // fatal in Database::CheckDatabaseVersion, whereas a content lag is only a warning and
    // would let exactly the affected database start silently.
    // The matching characters update deletes `instance_reset` and advances `db_version`.
    #define CHAR_DB_VERSION_NR          "23"
    #define CHAR_DB_STRUCTURE_NR        "2"
    #define CHAR_DB_CONTENT_NR          "1"
    // Must match, character for character, the description the characters update inserts
    // (Rel23_02_001_Instance_Reset_Difficulty_Key_Space.sql). db_version.description is
    // varchar(30); the previous string was 43 characters, so it could never equal any row
    // the update could write. Harmless -- CheckDatabaseVersion only PRINTS the description
    // and gates on version/structure -- but it made the mismatch banner advertise an
    // expected value no database could ever hold.
    #define CHAR_DB_UPDATE_DESCRIPT     "difficulty key spaces"

    #define WORLD_DB_VERSION_NR         "23"
    #define WORLD_DB_STRUCTURE_NR       "3"
    #define WORLD_DB_CONTENT_NR         "10"
    #define WORLD_DB_UPDATE_DESCRIPT    "Add BlobId field to quest_poi"

    #define VER_COMPANY_NAME_STR        "MaNGOS Developers"
    #define VER_LEGALCOPYRIGHT_STR      "(c)2005-@rev_year@ MaNGOS"
    #define VER_FILEVERSION             0,0,0
    #define VER_FILEVERSION_STR         "@rev_hash@ @rev_date@ (@rev_branch@ branch)"
    #define VER_PRODUCTVERSION          VER_FILEVERSION
    #define VER_PRODUCTVERSION_STR      VER_FILEVERSION_STR
#endif
